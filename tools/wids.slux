#slux name wids
#slux desc "PocketWIDS console — live wireless IDS events from your M5Stick sensor"
#slux version 1.0.0

# bash section
mkdir -p /usr/bin

#slux code
register("wids", function (args) {
  var sub = (args[0] || "log").toLowerCase();

  if (sub === "help" || sub === "--help" || sub === "-h") {
    print("usage: wids [log|status] [n]");
    print("");
    print("  wids log [n]    latest sensor events (default 15)");
    print("  wids status     summary of the event feed");
    print("");
    print("sensor: M5Stick PocketWIDS -> POST /api/wids -> R2");
    return;
  }

  var limit = parseInt(args[1], 10);
  if (!limit || limit < 1) limit = 15;
  if (limit > 1000) limit = 1000;

  if (sub === "status") limit = 500;

  print("querying sensor feed ...");

  fetch("/api/wids?limit=" + encodeURIComponent(limit))
    .then(function (r) {
      if (!r.ok) throw new Error("HTTP " + r.status);
      return r.json();
    })
    .then(function (d) {
      var evs = d.events || [];
      if (!evs.length) {
        print("no events yet. power the stick on and wait for it to phone home.");
        return;
      }

      if (sub === "status") {
        var counts = {};
        var newest = evs[0];
        for (var i = 0; i < evs.length; i++) {
          var t = evs[i].type || "event";
          counts[t] = (counts[t] || 0) + 1;
        }
        printHtml("<b>PocketWIDS status</b> — " + d.count + " total event(s)");
        var order = Object.keys(counts).sort();
        for (var j = 0; j < order.length; j++) {
          var c = counts[order[j]];
          var color = order[j] === "ALARM" || order[j] === "ROGUE" ? "#e95420" : "#4e9a06";
          printHtml('<span style="color:' + color + '">  ' +
            esc(order[j]) + "</span>: " + c);
        }
        print("last event: " + esc(new Date(newest.ts).toLocaleString()) +
          " (" + esc(newest.type) + ")");
        return;
      }

      if (sub !== "log") {
        err("unknown subcommand: " + sub + " (try: wids help)");
        return;
      }

      printHtml("<b>PocketWIDS feed</b> — showing " + evs.length +
        " of " + d.count + " event(s), newest first");
      for (var k = 0; k < evs.length; k++) {
        var e = evs[k];
        var t = new Date(e.ts).toLocaleTimeString();
        var hot = e.type === "ALARM" || e.type === "ROGUE";
        var col = hot ? "#e95420" : e.type === "ACK" ? "#729fcf" : "#4e9a06";
        var ch = (e.channel === null || e.channel === undefined) ? "-" : e.channel;
        printHtml('<span style="color:#c9c9c3">[' + esc(t) + "]</span> " +
          '<span style="color:' + col + ';font-weight:bold">' + esc(e.type) +
          "</span> ch" + esc(ch) + " " + esc(e.detail || ""));
      }
    })
    .catch(function (e2) {
      err("fetch failed: " + e2.message);
    });
});
