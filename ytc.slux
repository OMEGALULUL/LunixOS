#slux name ytc
#slux desc "YouTube converter — pull mp3/mp4 straight to your device via ytc.blueberryservices.co.za"
#slux version 1.0.0

# bash section
mkdir -p /usr/bin

#slux code
register("ytc", function (args) {
  var UPSTREAM = "https://ytc.blueberryservices.co.za";
  var base = "/api/ytc";
  try {
    if (location.protocol === "file:") {
      var fb = (typeof FALLBACK_API !== "undefined" && FALLBACK_API) ? FALLBACK_API : "";
      base = fb ? fb + "/api/ytc" : UPSTREAM;
    }
  } catch (e) {}

  var QUALITIES = { mp3: ["320", "192", "128"], mp4: ["1080", "720", "480", "360"] };
  var YT = /^https?:\/\/(www\.|m\.|music\.)?(youtube\.com\/(watch\?|shorts\/|live\/)|youtu\.be\/)/i;

  function fmtSize(b) {
    if (!b && b !== 0) return "";
    if (b > 1048576) return (b / 1048576).toFixed(1) + " MB";
    return Math.max(1, Math.round(b / 1024)) + " KB";
  }
  function fmtEta(s) { return s < 60 ? s + "s" : Math.floor(s / 60) + ":" + String(s % 60).padStart(2, "0"); }

  function usage() {
    print("usage: ytc <yt-link> [mp3|mp4] [quality]");
    print("");
    print("  ytc https://youtu.be/dQw4w9WgXcQ          # mp3 @ 320 kbps (default)");
    print("  ytc https://youtu.be/dQw4w9WgXcQ mp3 192  # 192 kbps audio");
    print("  ytc https://youtube.com/watch?v=xyz mp4 720");
    print("");
    print("  mp3: 320 | 192 | 128 (kbps)   mp4: 1080 | 720 | 480 | 360 (p)");
    print("the file downloads straight to your device — the sim never stores it.");
    print("powered by ytc.blueberryservices.co.za (yt-dlp + ffmpeg)");
  }

  var link = args[0];
  if (!link || link === "-h" || link === "--help" || link === "help") return usage();
  if (!YT.test(link)) return err("ytc: that does not look like a youtube link (watch, shorts, live, or youtu.be)");

  var fmt = (args[1] || "mp3").toLowerCase();
  if (fmt === "audio") fmt = "mp3";
  if (fmt === "video") fmt = "mp4";
  if (fmt !== "mp3" && fmt !== "mp4") return err("ytc: format must be mp3 or mp4 (got '" + args[1] + "')");

  var quality = args[2] ? String(args[2]).replace(/[^0-9]/g, "") : QUALITIES[fmt][0];
  if (!quality || QUALITIES[fmt].indexOf(quality) === -1) {
    return err("ytc: " + fmt + " quality must be one of: " + QUALITIES[fmt].join(", ") + (fmt === "mp3" ? " (kbps)" : " (p)"));
  }

  print("ytc: queuing " + fmt.toUpperCase() + " @ " + quality + (fmt === "mp3" ? " kbps" : "p") + " ...");

  fetch(base + "/jobs", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ url: link, format: fmt, quality: quality })
  }).then(function (r) {
    return r.json().then(function (d) {
      if (!r.ok) throw new Error(d.error || "http " + r.status);
      return d;
    });
  }).then(function (job) {
    if (!job.id) throw new Error("no job id returned");
    print("ytc: job " + job.id + " started.");

    var line = document.createElement("div");
    line.className = "line";
    document.getElementById("vt-body").appendChild(line);

    function bar(pct) {
      var filled = Math.round(Math.min(pct, 100) / 5), s = "";
      for (var i = 0; i < 20; i++) s += i < filled ? "█" : "░";
      return s;
    }

    function saveFile(id, title) {
      fetch(base + "/download/" + encodeURIComponent(id)).then(function (r) {
        if (!r.ok) throw new Error("http " + r.status);
        return r.blob();
      }).then(function (blob) {
        var safe = String(title || "ytc-" + id).replace(/[^a-zA-Z0-9 ._()-]/g, "_").slice(0, 80) || ("ytc-" + id);
        var a = document.createElement("a");
        a.href = URL.createObjectURL(blob);
        a.download = safe + (fmt === "mp3" ? ".mp3" : ".mp4");
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(function () { URL.revokeObjectURL(a.href); }, 10000);
        print('ytc: saved "' + a.download + '" (' + fmtSize(blob.size) + ") straight to your device — nothing touched the sim.");
      }).catch(function (e4) {
        err("ytc: browser download failed (" + e4.message + ") — grab it manually: " + UPSTREAM + "/download/" + id);
      });
    }

    var timer = setInterval(function () {
      fetch(base + "/jobs/" + encodeURIComponent(job.id)).then(function (r) {
        if (r.status === 404) throw new Error("job expired — start another one");
        return r.json();
      }).then(function (st) {
        if (st.state === "error") throw new Error(st.error || "conversion failed");
        var stage = st.state === "queued" ? "fetching" : st.state;
        var pct = Math.min(st.percent || 0, 100);
        var bits = [];
        if (st.speed) bits.push(fmtSize(st.speed) + "/s");
        if (st.eta) bits.push("eta " + fmtEta(st.eta));
        line.innerHTML = '<span class="accent">ytc</span> [' + bar(pct) + "] " +
          (stage === "processing" ? "converting…" : Math.floor(pct) + "% " + stage) +
          (bits.length ? ' <span class="dim">' + esc(bits.join(" · ")) + "</span>" : "");
        if (st.state === "done") {
          clearInterval(timer);
          line.innerHTML = '<span class="ok">ytc</span> [████████████████████] 100% — ' + esc(st.title || "done") + ' <span class="dim">(' + fmtSize(st.size || 0) + ")</span>";
          saveFile(job.id, st.title);
        }
      }).catch(function (e3) {
        clearInterval(timer);
        line.innerHTML = '<span class="fatal">ytc</span> failed: ' + esc(e3.message);
        err("ytc: " + e3.message);
      });
    }, 800);
  }).catch(function (e2) {
    var msg = e2.message || String(e2);
    if (/Failed to fetch|NetworkError/i.test(msg)) {
      msg = "could not reach the converter" + (base.indexOf("http") === 0 ? " (cross-origin blocked — host lunix behind its worker, or add CORS to the converter)" : " (converter unreachable)");
    }
    err("ytc: " + msg);
  });
});
